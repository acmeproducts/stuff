{
  "schema": "market-navigator-publication-rules-v1",
  "version": "1.2.0-corpus",
  "status": "canonical-r7",
  "purpose": "Deterministic publication-expectation rules used to distinguish expected lag from stale, missing, failed and sparse canonical evidence.",
  "rules": {
    "cpi": {
      "cadence": "monthly",
      "expected_observation": "previous-calendar-month",
      "available_by_day_of_month": 15,
      "timezone": "America/New_York",
      "note": "By mid-month, the prior calendar month's CPI observation is expected to be publicly available."
    },
    "coreCpi": {
      "cadence": "monthly",
      "expected_observation": "previous-calendar-month",
      "available_by_day_of_month": 15,
      "timezone": "America/New_York"
    },
    "pce": {
      "cadence": "monthly",
      "expected_observation": "previous-calendar-month",
      "available_by_day_of_month": 31,
      "timezone": "America/New_York",
      "note": "Use month-end expectation as a conservative deterministic fallback when an exact release calendar is not embedded."
    },
    "corePce": {
      "cadence": "monthly",
      "expected_observation": "previous-calendar-month",
      "available_by_day_of_month": 31,
      "timezone": "America/New_York"
    },
    "payrolls": {
      "cadence": "monthly",
      "expected_observation": "previous-calendar-month",
      "available_by_day_of_month": 10,
      "timezone": "America/New_York"
    },
    "industrialProduction": {
      "cadence": "monthly",
      "expected_observation": "previous-calendar-month",
      "available_by_day_of_month": 20,
      "timezone": "America/New_York"
    },
    "retailSales": {
      "cadence": "monthly",
      "expected_observation": "previous-calendar-month",
      "available_by_day_of_month": 20,
      "timezone": "America/New_York"
    },
    "initialClaims": {
      "cadence": "weekly",
      "release_weekday": 3,
      "release_hour": 8,
      "release_minute": 30,
      "reference_days_before_release": 5,
      "timezone": "America/New_York",
      "ingestion_grace_hours": 24,
      "holiday_rule": "Conservative next business day when Thursday is a federal holiday; no early stale claim.",
      "source": "https://oui.doleta.gov/unemploy/claims_arch.asp/claims.asp"
    },
    "nfci": {
      "cadence": "weekly",
      "release_weekday": 2,
      "release_hour": 8,
      "release_minute": 30,
      "reference_days_before_release": 5,
      "timezone": "America/New_York",
      "ingestion_grace_hours": 24,
      "holiday_rule": "Federal holiday Monday through Wednesday delays release to Thursday; conservative additional day on holidays.",
      "source": "https://www.chicagofed.org/research/data/nfci/current-data"
    },
    "realGdp": {
      "cadence": "quarterly",
      "max_expected_age_days": 110
    },
    "default_daily": {
      "cadence": "daily",
      "max_expected_age_days": 5
    },
    "default_trading_day": {
      "cadence": "trading-day",
      "max_expected_age_days": 5
    },
    "manufacturingProduction": {
      "cadence": "monthly",
      "expected_observation": "previous-calendar-month",
      "available_by_day_of_month": 18,
      "timezone": "America/New_York",
      "note": "Federal Reserve G.17 manufacturing-production release; owner-approved replacement for explicitly excluded ISM PMI."
    }
  },
  "classification_precedence": [
    "failed",
    "missing",
    "stale",
    "sparse",
    "expected-lag",
    "current"
  ],
  "rule": "Collector HTTP success is not evidence currentness. Currentness is determined by reconciling expected publication availability, latest canonical observation, collector attempt/result and horizon coverage."
}
