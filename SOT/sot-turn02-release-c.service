[Unit]
Description=SOT Turn 02 Release C
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
Environment=SOT_PORT=8765
WorkingDirectory=%h/.sot-turn02/release-c/SOT
ExecStart=/usr/bin/python3 %h/.sot-turn02/release-c/SOT/sot-turn02-release-c-server.py
Restart=always
RestartSec=1
KillSignal=SIGTERM
TimeoutStopSec=10

[Install]
WantedBy=default.target
