[Unit]
Description=SOT Turn 02 clean3 isolated runtime
After=network.target
StartLimitIntervalSec=0
[Service]
Type=simple
Environment=SOT_PORT=8765
WorkingDirectory=%h/.sot-turn02/v8-clean3/SOT
ExecStart=/usr/bin/python3 %h/.sot-turn02/v8-clean3/SOT/sot-turn02-v8-clean3-server.py
Restart=always
RestartSec=1
KillSignal=SIGTERM
TimeoutStopSec=10
[Install]
WantedBy=default.target
