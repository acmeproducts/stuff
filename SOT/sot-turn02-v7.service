[Unit]
Description=SOT Turn 02 v7 backend
After=network.target
StartLimitIntervalSec=0
[Service]
Type=simple
Environment=SOT_PORT=8765
WorkingDirectory=%h/.sot-turn02/v7/SOT
ExecStart=/usr/bin/python3 %h/.sot-turn02/v7/SOT/sot-turn02-pre-base-v7-server.py
Restart=always
RestartSec=1
KillSignal=SIGTERM
TimeoutStopSec=10
[Install]
WantedBy=default.target
