[Unit]
Description=SOT Turn 02 Release D
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
Environment=SOT_PORT=8765
Environment=SOT_MAX_ACTIVE_JOBS=2
WorkingDirectory=%h/.sot-turn02/release-d/SOT
ExecStart=/usr/bin/python3 %h/.sot-turn02/release-d/SOT/sot-turn02-release-d-server.py
Restart=always
RestartSec=1
KillSignal=SIGTERM
TimeoutStopSec=10

[Install]
WantedBy=default.target
