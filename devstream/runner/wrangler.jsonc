{
  "name": "devstream-runner",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "vars": { "ALLOWED_OWNER": "acmeproducts" },
  "durable_objects": { "bindings": [{ "name": "RUNNER", "class_name": "Runner" }, { "name": "VAULT", "class_name": "Vault" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Runner"] }, { "tag": "v2", "new_sqlite_classes": ["Vault"] }]
}
