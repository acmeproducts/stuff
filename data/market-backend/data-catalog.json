  "horizon_policy": {
    "1D": "Latest valid observation versus the immediately preceding applicable observation/session.",
    "1YR": "Latest valid observation versus the nearest valid observation on or before one calendar year earlier.",
    "3YR": "Latest valid observation versus the nearest valid observation on or before three calendar years earlier.",
    "5D": "Latest valid observation versus the nearest valid observation five applicable observation/trading days earlier.",
    "5YR": "Latest valid observation versus the nearest valid observation on or before five calendar years earlier.",
    "MTD": "Month-to-date from the last valid observation at or before the beginning of the current calendar month to the common market anchor.",
    "YTD": "Year-to-date from the last valid observation at or before the beginning of the current calendar year to the common market anchor.",
    "low_frequency_rule": "Do not fabricate daily observations for weekly, monthly or quarterly series. Use actual published observations and expose no-new-release state when appropriate."
  },
  "noncanonical_existing_data": {
    "market_intraday": {
      "description": "The current collector also maintains five-day 15-minute Yahoo market caches. These are not required by the newly defined daily canonical evidence baseline and must not be treated as authoritative until explicitly retained.",
      "status": "inventory-only-pending-retirement-decision"
    },
    "weighted_indexes": {
      "description": "Existing Risk/Growth/Macro/Regime weighted scoring artifacts are not source data and are excluded from this catalog.",
      "status": "noncanonical-pending-retirement"
    }
  },
  "principles": {
    "ai_computes_source_statistics": false,
    "all_derived_values_trace_to_canonical_observations": true,
    "architecture": "smart data, dumb reports",
    "catalog_is_definition": true,
    "daily_workflow_reads_catalog": true,
    "manifest_is_runtime_state": true,
    "ui_computes_market_history": false
  },
  "publication_schedule": {
    "cadence_rules": {
      "daily": {
        "current_max_age_days": 5,
        "expected_lag_max_age_days": 7,
        "label": "Each applicable day"
      },
      "monthly": {
        "current_max_age_days": 45,
        "expected_lag_max_age_days": 75,
        "label": "Monthly publication"
      },
      "quarterly": {
        "current_max_age_days": 110,
