{
  "schema": "market-navigator-data-catalog-v1",
  "version": "1.1.0",
  "status": "authoritative-baseline-amended",
  "purpose": "Authoritative metadata registry for every canonical Market Navigator source series and contextual feed. This file defines what data is supposed to exist. Runtime health, freshness, coverage and revisions belong in the operational manifest.",
  "principles": {
    "architecture": "smart data, dumb reports",
    "catalog_is_definition": true,
    "manifest_is_runtime_state": true,
    "ui_computes_market_history": false,
    "ai_computes_source_statistics": false,
    "daily_workflow_reads_catalog": true,
    "all_derived_values_trace_to_canonical_observations": true
  },
  "canonical_horizons": [
    "1D",
    "5D",
    "1M",
    "YTD",
    "1Y",
    "3Y",
    "5Y"
  ],
  "horizon_policy": {
    "1D": "Latest valid observation versus the immediately preceding applicable observation/session.",
    "5D": "Latest valid observation versus the nearest valid observation five applicable observation/trading days earlier.",
    "1M": "Latest valid observation versus the nearest valid observation on or before one calendar month earlier.",
    "YTD": "Latest valid observation versus the last valid observation at or before the beginning of the current calendar year.",
    "1Y": "Latest valid observation versus the nearest valid observation on or before one calendar year earlier.",
    "3Y": "Latest valid observation versus the nearest valid observation on or before three calendar years earlier.",
    "5Y": "Latest valid observation versus the nearest valid observation on or before five calendar years earlier.",
    "low_frequency_rule": "Do not fabricate daily observations for weekly, monthly or quarterly series. Use actual published observations and expose no-new-release state when appropriate."
  },
  "publication_schedule": {
    "timezone": "UTC",
    "purpose": "Deterministic cadence-aware freshness classification for Health, charts and AI evidence preflight.",
    "cadence_rules": {
      "trading-day": {
        "label": "Each applicable trading day",
        "current_max_age_days": 5,
        "expected_lag_max_age_days": 7
      },
      "daily": {
        "label": "Each applicable day",
        "current_max_age_days": 5,
        "expected_lag_max_age_days": 7
      },
      "weekly": {
        "label": "Weekly release",
        "current_max_age_days": 10,
        "expected_lag_max_age_days": 18
      },
      "monthly": {
        "label": "Monthly publication",
        "current_max_age_days": 45,
        "expected_lag_max_age_days": 75
      },
      "quarterly": {
        "label": "Quarterly publication",
        "current_max_age_days": 110,
        "expected_lag_max_age_days": 150
      }
    },
    "series_overrides": {
      "cpi": {
        "label": "Monthly · about day 16",
        "expected_day_of_month": 16
      },
      "coreCpi": {
        "label": "Monthly · about day 16",
        "expected_day_of_month": 16
      },
      "pce": {
        "label": "Monthly · about day 28",
        "expected_day_of_month": 28
      },
      "corePce": {
        "label": "Monthly · about day 28",
        "expected_day_of_month": 28
      },
      "payrolls": {
        "label": "Monthly · about day 8",
        "expected_day_of_month": 8
      },
      "industrialProduction": {
        "label": "Monthly · about day 20",
        "expected_day_of_month": 20
      },
      "retailSales": {
        "label": "Monthly · about day 20",
        "expected_day_of_month": 20
      },
      "realGdp": {
        "label": "Quarterly · about day 30",
        "expected_day_of_month": 30
      }
    }
  },
  "bootstrap_policy": {
    "minimum_history_years": 6,
    "preferred_history_years": 10,
    "reason": "Five-year visualization and comparison windows require margin before T0 and should not require annual re-bootstrap.",
    "rebuild_mode": "one-time full historical bootstrap followed by incremental maintenance"
  },
  "runtime_state_fields_required_in_manifest": [
    "status",
    "first_observation",
    "latest_observation",
    "observation_count",
    "last_attempted",
    "last_successful",
    "next_due",
    "bootstrap_complete",
    "horizon_readiness",
    "missing_periods",
    "last_error",
    "source_revision",
    "computed_revision"
  ],
