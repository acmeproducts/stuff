{
  "name": "talkbridge-build",
  "private": true,
  "description": "Gate dependencies only — the app itself is a single dependency-free HTML file.",
  "scripts": {
    "build:27s8": "node talkbridge/build/assemble-27s8.mjs",
    "gate:27s8:assembled": "node talkbridge/build/assemble-27s8.mjs --check",
    "gate:27s8:app": "node talkbridge/build/harness-27s8.mjs",
    "gate:27s8:checks": "node talkbridge/build/checks-27s8.mjs --selftest",
    "gate:27s8:mutations": "node talkbridge/build/mutate-27s8.mjs",
    "gate:27s8": "npm run gate:27s8:assembled && npm run gate:27s8:app && npm run gate:27s8:checks && npm run gate:27s8:mutations",
    "build:27ps": "node talkbridge/build/assemble-27ps.mjs",
    "gate:27ps:assembled": "node talkbridge/build/assemble-27ps.mjs --check",
    "gate:27ps:app": "node talkbridge/build/harness-27ps.mjs",
    "gate:27ps:checks": "node talkbridge/build/checks-27ps.mjs --selftest",
    "gate:27ps:mutations": "node talkbridge/build/mutate-27ps.mjs",
    "gate:27ps": "npm run gate:27ps:assembled && npm run gate:27ps:app && npm run gate:27ps:checks && npm run gate:27ps:mutations",
    "gate:governance": "node talkbridge/build/governance-gate.mjs --base HEAD && node --test talkbridge/build/governance-gate.test.mjs",
    "gate:worker": "node talkbridge/build/harness-sw-r10-cr3.mjs",
    "build:28b": "node talkbridge/build/assemble-28b.mjs",
    "gate:28b:assembled": "node talkbridge/build/assemble-28b.mjs --check",
    "gate:28b:diff": "node talkbridge/build/harness-diff-28b.mjs",
    "gate:28b:prior": "TB_SKIP_M1=1 node talkbridge/build/harness-27ps.mjs bridge-turn28-base.html",
    "gate:28b:checks": "node talkbridge/build/checks-28b.mjs --selftest",
    "gate:28b:mutations": "node talkbridge/build/mutate-28b.mjs",
    "gate:28b": "npm run gate:28b:assembled && npm run gate:28b:diff && npm run gate:28b:prior && npm run gate:28b:checks && npm run gate:28b:mutations"
  },
  "devDependencies": {
    "jsdom": "^24.1.3",
    "ws": "^8.17.0"
  }
}
