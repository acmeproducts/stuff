{
  "schema": "market-navigator-trend-model-v1",
  "version": "MN-TREND-1.0.0",
  "horizon": "approximately 10-30 days",
  "states": ["POSITIVE", "NEUTRAL", "NEGATIVE", "UNAVAILABLE"],
  "publicationRule": "Each source votes from persistence of recent changes. Positive/negative requires at least two independent source-family votes in that direction and no opposing directional majority; insufficient current evidence is UNAVAILABLE, never NEUTRAL.",
  "models": {
    "macro": {
      "label": "MAC Trend",
      "sources": [
        {"id":"wei","provider":"FRED","identifier":"WEI","cadence":"weekly","favorableDirection":1,"family":"real activity","name":"Weekly Economic Index"},
        {"id":"anfci","provider":"FRED","identifier":"ANFCI","cadence":"weekly","favorableDirection":-1,"family":"financial conditions","name":"Adjusted National Financial Conditions Index"},
        {"id":"initialClaims","provider":"FRED","identifier":"ICSA","cadence":"weekly","favorableDirection":-1,"family":"labor","name":"Initial Claims"}
      ]
    },
    "growth": {
      "label": "GRW Trend",
      "sources": [
        {"id":"wei","provider":"FRED","identifier":"WEI","cadence":"weekly","favorableDirection":1,"family":"real activity","name":"Weekly Economic Index"},
        {"id":"lmciMomentum","provider":"FRED","identifier":"FRBKCLMCIM","cadence":"monthly","favorableDirection":1,"family":"labor momentum","name":"KC Fed Labor Market Conditions Momentum"},
        {"id":"initialClaims","provider":"FRED","identifier":"ICSA","cadence":"weekly","favorableDirection":-1,"family":"labor stress","name":"Initial Claims"}
      ]
    },
    "risk": {
      "label": "RSK Trend",
      "positiveMeaning": "risk conditions improving/easing",
      "sources": [
        {"id":"nfciRisk","provider":"FRED","identifier":"NFCIRISK","cadence":"weekly","favorableDirection":-1,"family":"financial risk","name":"NFCI Risk Subindex"},
        {"id":"nfciNonfinancialLeverage","provider":"FRED","identifier":"NFCINONFINLEVERAGE","cadence":"weekly","favorableDirection":-1,"family":"leverage","name":"NFCI Nonfinancial Leverage Subindex"},
        {"id":"stlfsi","provider":"FRED","identifier":"STLFSI4","cadence":"weekly","favorableDirection":-1,"family":"financial stress","name":"St. Louis Fed Financial Stress Index"}
      ]
    }
  }
}
