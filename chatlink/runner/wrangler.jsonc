{
  "name": "chatlink-runner",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "vars": { "ALLOWED_OWNER": "acmeproducts" },
  "durable_objects": { "bindings": [{ "name": "VAULT", "class_name": "Vault" }, { "name": "USAGE", "class_name": "Usage" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Vault"] }, { "tag": "v2", "new_sqlite_classes": ["Usage"] }]
}
